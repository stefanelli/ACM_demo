# Aloe backend environment variables (copy to `.env` and adjust).
# `.env` is git-ignored; do NOT commit real secrets.

# Database (matches docker-compose.yml defaults)
POSTGRES_USER=aloe
POSTGRES_PASSWORD=aloe
POSTGRES_DB=aloe
POSTGRES_HOST=localhost
POSTGRES_PORT=5434

# Market-data service source: mock | databento
MDS_SOURCE=mock
